{include file="sections/header.tpl"}
<div class="row"><div class="col-sm-12"><div class="ibox"><div class="ibox-title"><h3><i class="ion ion-calendar"></i> Kompensasi Masa Aktif</h3><p class="text-muted">Memperpanjang masa aktif pelanggan PREPAID yang sedang aktif. POSTPAID dan layanan nonaktif tidak ditampilkan.</p></div><div class="ibox-content">
{if $message}<div class="alert alert-success">{$message|escape}</div>{/if}{if $error}<div class="alert alert-danger">{$error|escape}</div>{/if}
<form method="get" action="{$_url}plugin/kompensasi_masa_aktif" class="form-inline" style="margin-bottom:15px"><input type="hidden" name="_route" value="plugin/kompensasi_masa_aktif"><input class="form-control" name="search" value="{$search|escape}" placeholder="Cari nama / username / paket"><select class="form-control" name="expiry"><option value="">Semua tanggal expired</option><option value="today" {if $expiryFilter=='today'}selected{/if}>Expired hari ini</option><option value="7" {if $expiryFilter=='7'}selected{/if}>7 hari ke depan</option><option value="30" {if $expiryFilter=='30'}selected{/if}>30 hari ke depan</option><option value="later" {if $expiryFilter=='later'}selected{/if}>Lebih dari 30 hari</option></select><button class="btn btn-primary" type="submit">Filter</button> <a class="btn btn-default" href="{$_url}plugin/kompensasi_masa_aktif">Reset</a></form>
<form method="post" action="{$_url}plugin/kompensasi_masa_aktif" id="compForm"><input type="hidden" name="action" value="apply"><input type="hidden" name="csrf_token" value="{$csrf_token|escape}">
<div class="row" style="margin-bottom:15px"><div class="col-md-3"><label>Tambah masa aktif (hari)</label><input type="number" class="form-control" name="days" id="days" min="1" max="365" required placeholder="Masukkan jumlah hari"></div><div class="col-md-6"><label>Catatan kompensasi (opsional)</label><input type="text" class="form-control" name="note" maxlength="255" placeholder="Contoh: Gangguan jaringan massal 3 hari"></div><div class="col-md-3"><label>&nbsp;</label><div><span class="label label-success">PREPAID</span> <span class="label label-info">Status ON</span> <span class="label label-default">Maks. 1000 baris</span></div></div></div>
<div class="table-responsive"><table class="table table-bordered table-striped"><thead><tr><th><input type="checkbox" id="selectAll"></th><th>Nama Pelanggan</th><th>Username PPPoE</th><th>Paket</th><th>Tanggal Registrasi</th><th>Tanggal Expired</th><th>Status</th></tr></thead><tbody>
{foreach $customers as $c}<tr data-username="{$c.username|escape}" data-old-expiry="{$c.expiration|escape}" data-expiry-time="{$c.time|escape}"><td><input type="checkbox" class="customer-check" name="recharge_ids[]" value="{$c.recharge_id}"></td><td>{$c.fullname|escape}</td><td>{$c.username|escape}</td><td>{$c.name_plan|escape}</td><td>{$c.recharged_on|escape}</td><td>{$c.expiration|escape} {$c.time|escape}</td><td><span class="label label-success">Aktif</span></td></tr>{foreachelse}<tr><td colspan="7" class="text-center">Tidak ada pelanggan PREPAID aktif yang cocok dengan filter.</td></tr>{/foreach}
</tbody></table></div>
<div class="well"><label><input type="checkbox" name="notify" value="1" id="notifyToggle"> Send Notification</label><div id="channels" style="display:none;margin-top:10px"><strong>Notification via:</strong> &nbsp; <label><input type="checkbox" name="sms"> SMS</label> &nbsp; <label><input type="checkbox" name="wa"> WA</label> &nbsp; <label><input type="checkbox" name="mail"> Email</label> &nbsp; <label><input type="checkbox" name="inbox"> Kotak Masuk</label><p class="help-block">Menggunakan gateway dan konfigurasi notifikasi bawaan PHPNuxBill.</p></div></div>
<div class="alert alert-info">Preview: <strong><span id="selectedCount">0</span></strong> pelanggan dipilih. Setiap tanggal expired akan ditambah sejumlah hari yang dimasukkan, tanpa mengubah status layanan.</div>
<button type="button" class="btn btn-success" id="previewBtn"><i class="fa fa-eye"></i> Preview Perubahan</button> <button type="submit" class="btn btn-primary" id="applyBtn" disabled><i class="fa fa-calendar-plus-o"></i> Proses Kompensasi</button>
<div id="previewArea" style="display:none;margin-top:15px" class="alert alert-warning"></div></form>
</div></div></div></div>
<div class="row"><div class="col-sm-12"><div class="ibox"><div class="ibox-title"><h3>Riwayat Kompensasi Terakhir</h3></div><div class="ibox-content table-responsive"><table class="table table-bordered"><thead><tr><th>Kode Batch</th><th>Tanggal</th><th>Hari</th><th>Jumlah Pelanggan</th><th>Admin</th></tr></thead><tbody>{foreach $history as $h}<tr><td>{$h.batch_code|escape}</td><td>{$h.created_at|escape}</td><td>+{$h.days}</td><td>{$h.total_customers}</td><td>{$h.admin_name|escape}</td></tr>{foreachelse}<tr><td colspan="5" class="text-center">Belum ada riwayat.</td></tr>{/foreach}</tbody></table></div></div></div></div>
<script>
{literal}
(function(){var all=document.getElementById('selectAll'), boxes=[].slice.call(document.querySelectorAll('.customer-check')), count=document.getElementById('selectedCount'), days=document.getElementById('days'), preview=document.getElementById('previewArea'), apply=document.getElementById('applyBtn');function refresh(){var n=boxes.filter(function(b){return b.checked}).length;count.textContent=n;apply.disabled=n===0||!days.value||parseInt(days.value,10)<1;}all&&all.addEventListener('change',function(){boxes.forEach(function(b){b.checked=all.checked});refresh()});boxes.forEach(function(b){b.addEventListener('change',refresh)});days.addEventListener('input',refresh);document.getElementById('notifyToggle').addEventListener('change',function(){document.getElementById('channels').style.display=this.checked?'block':'none'});document.getElementById('previewBtn').addEventListener('click',function(){var n=boxes.filter(function(b){return b.checked}).length,d=parseInt(days.value,10)||0;if(!n||d<1){alert('Pilih pelanggan dan masukkan jumlah hari yang valid.');return;}preview.style.display='block';var chosen=boxes.filter(function(b){return b.checked;}).map(function(b){var tr=b.closest('tr'),old=tr.getAttribute('data-old-expiry'),dt=new Date(old+'T12:00:00');dt.setDate(dt.getDate()+d);var y=dt.getFullYear(),m=('0'+(dt.getMonth()+1)).slice(-2),day=('0'+dt.getDate()).slice(-2);return '<tr><td>'+tr.getAttribute('data-username')+'</td><td>'+old+'</td><td><strong>'+y+'-'+m+'-'+day+'</strong></td></tr>';}).join('');preview.innerHTML='<strong>Preview perubahan:</strong><p>'+n+' pelanggan PREPAID aktif akan diperpanjang '+d+' hari. Pelanggan POSTPAID, nonaktif, dan expired tidak diproses. Status layanan tidak diubah. Notifikasi: '+(document.getElementById('notifyToggle').checked?'aktif sesuai kanal yang dipilih':'nonaktif')+'.</p><div class="table-responsive"><table class="table table-condensed table-bordered"><thead><tr><th>Username</th><th>Expired lama</th><th>Expired baru</th></tr></thead><tbody>'+chosen+'</tbody></table></div>';apply.disabled=false;});document.getElementById('compForm').addEventListener('submit',function(e){var n=boxes.filter(function(b){return b.checked}).length,d=days.value;if(!confirm('Yakin memproses kompensasi '+d+' hari untuk '+n+' pelanggan terpilih? Proses ini akan mengubah tanggal expired.'))e.preventDefault();});refresh();})();
{/literal}
</script>
{include file="sections/footer.tpl"}
